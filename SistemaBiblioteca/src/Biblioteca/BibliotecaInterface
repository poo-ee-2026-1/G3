    private JPanel criarPainelTabela() {
        JPanel p = new JPanel(new BorderLayout());
        p.setBackground(COR_FUNDO);
        p.setBorder(new EmptyBorder(20, 35, 10, 35));

        modeloTabela = new DefaultTableModel(new String[]{"ID", "Título", "Autor", "Gênero", "Seção", "Status"}, 0) {
            @Override public boolean isCellEditable(int r, int c) { return false; }
        };
        tabela = new JTable(modeloTabela);
        configurarTabela();

        JScrollPane s = new JScrollPane(tabela);
        s.setBorder(BorderFactory.createLineBorder(new Color(200, 210, 225)));
        s.getViewport().setBackground(Color.WHITE);

        JPanel busca = new JPanel(new FlowLayout(FlowLayout.LEFT, 0, 15));
        busca.setOpaque(false);
        JLabel lblP = new JLabel("Pesquisar:  ");
        lblP.setFont(new Font("Segoe UI", Font.BOLD, 14));
        JTextField tB = new JTextField(35); 
        estilizarCampo(tB);
        tB.addKeyListener(new KeyAdapter() { @Override public void keyReleased(KeyEvent e) { filtrarTabela(tB.getText()); }});
        busca.add(lblP); busca.add(tB);

        p.add(busca, BorderLayout.NORTH);
        p.add(s, BorderLayout.CENTER);

        lblStatus = new JLabel("Total de livros: 0");
        lblStatus.setFont(new Font("Segoe UI", Font.BOLD, 13));
        lblStatus.setBorder(new EmptyBorder(15, 0, 0, 0));
        p.add(lblStatus, BorderLayout.SOUTH);
        return p;
    }

    private void configurarTabela() {
        tabela.setRowHeight(40);
        tabela.setFont(new Font("Segoe UI", Font.PLAIN, 14));
        tabela.setSelectionBackground(new Color(210, 230, 250));
        tabela.setSelectionForeground(Color.BLACK);
        tabela.setShowVerticalLines(false);
        tabela.setGridColor(new Color(230, 230, 230));
        
        JTableHeader h = tabela.getTableHeader();
        h.setPreferredSize(new Dimension(0, 45));
        h.setDefaultRenderer(new DefaultTableCellRenderer() {
            @Override public Component getTableCellRendererComponent(JTable t, Object v, boolean s, boolean f, int r, int c) {
                JLabel l = (JLabel) super.getTableCellRendererComponent(t, v, s, f, r, c);
                l.setBackground(COR_HEADER); l.setForeground(Color.WHITE);
                l.setFont(new Font("Segoe UI", Font.BOLD, 15));
                l.setHorizontalAlignment(JLabel.CENTER);
                l.setBorder(BorderFactory.createMatteBorder(0, 0, 1, 1, new Color(255, 255, 255, 30)));
                return l;
            }
        });

        tabela.setDefaultRenderer(Object.class, new DefaultTableCellRenderer() {
            @Override public Component getTableCellRendererComponent(JTable t, Object v, boolean s, boolean f, int r, int c) {
                Component comp = super.getTableCellRendererComponent(t, v, s, f, r, c);
                if (!s) comp.setBackground(r % 2 == 0 ? COR_LINHA_PAR : COR_LINHA_IMPAR);
                if (c == 3 && v != null) {
                    boolean disp = v.toString().equals("Disponível");
                    comp.setForeground(disp ? COR_DISPONIVEL : COR_EMPRESTADO);
                    comp.setFont(new Font("Segoe UI", Font.BOLD, 14));
                } else {
                    comp.setForeground(new Color(50, 50, 50));
                }
                ((JLabel)comp).setBorder(new EmptyBorder(0, 15, 0, 15));
                return comp;
            }
        });
    }

    private JPanel criarPainelBotoes() {
        JPanel p = new JPanel(new FlowLayout(FlowLayout.CENTER, 25, 30));
        p.setBackground(new Color(230, 235, 240));
        p.setBorder(BorderFactory.createMatteBorder(1, 0, 0, 0, new Color(200, 210, 225)));
        
        JButton bA = criarBotao("Adicionar", COR_BOTAO_ADD, "");
        JButton bE = criarBotao("Emprestar", COR_BOTAO_EMP, "");
        JButton bD = criarBotao("Devolver", COR_BOTAO_DEV, "");
        JButton bX = criarBotao("Excluir", COR_BOTAO_EXC, "");

        bA.addActionListener(e -> abrirDialogoAdicionar());
        bE.addActionListener(e -> abrirDialogoEmprestimo());
        bD.addActionListener(e -> abrirDialogoDevolucao());
        bX.addActionListener(e -> abrirDialogoExcluir());

        if (usuarioLogado instanceof Funcionario) p.add(bA);
        p.add(bE); p.add(bD);
        if (usuarioLogado instanceof Funcionario) p.add(bX);

        return p;
    }

    // ── Dialogos de Ação ───────────────────────────────────────────────────────
    private void abrirDialogoAdicionar() {
        JDialog d = criarDialogo("Adicionar Livro", 520, 380);
        JPanel f = criarPainelForm();
        JTextField t = new JTextField(20); estilizarCampo(t);
        JTextField a = new JTextField(20); estilizarCampo(a);
        String[] generos = {"Romance", "Fantasia", "Ficcao Cientifica", "Suspense", "Terror", "Aventura", "Outros"};
        JComboBox<String> g = new JComboBox<>(generos);
        g.setFont(new Font("Segoe UI", Font.PLAIN, 14));
        adicionarLinha(f, "Titulo:", t); 
        adicionarLinha(f, "Autor:", a);
        adicionarLinha(f, "Genero:", g);
        JButton btn = criarBotao("Salvar", COR_BOTAO_ADD, "");
        btn.addActionListener(e -> {
            if(t.getText().trim().isEmpty()) return;
            int secao = g.getSelectedIndex() + 1;
            livros.add(new Livro(proximoId++, t.getText().trim(), a.getText().trim(), (String)g.getSelectedItem(), secao));
            atualizarTabela(); d.dispose();
        });
        d.add(f, BorderLayout.CENTER); d.add(criarRodapeDialogo(btn, new JButton("Cancelar")), BorderLayout.SOUTH);
        d.setVisible(true);
    }

    private void abrirDialogoEmprestimo() {
        int r = tabela.getSelectedRow();
        String idI = (r >= 0) ? modeloTabela.getValueAt(r, 0).toString() : "";
        JDialog d = criarDialogo("Emprestar", 420, 260);
        JPanel f = criarPainelForm();
        JTextField t = new JTextField(idI, 10); estilizarCampo(t);
        adicionarLinha(f, "ID do Livro:", t);
        JButton btn = criarBotao("Confirmar", COR_BOTAO_EMP, "");
        btn.addActionListener(e -> {
            try {
                int id = Integer.parseInt(t.getText().trim());
                for(Livro l : livros) if(l.getId() == id) {
                    if(l.getDisponibilidade()) { l.setDisponibilidade(false); atualizarTabela(); d.dispose(); return; }
                    else { JOptionPane.showMessageDialog(d, "Livro já emprestado!"); return; }
                }
                JOptionPane.showMessageDialog(d, "Livro não encontrado!");
            } catch(Exception ex) { JOptionPane.showMessageDialog(d, "ID inválido!"); }
        });
        d.add(f, BorderLayout.CENTER); d.add(criarRodapeDialogo(btn, new JButton("Cancelar")), BorderLayout.SOUTH);
        d.setVisible(true);
    }

    private void abrirDialogoDevolucao() {
        int r = tabela.getSelectedRow();
        String idI = (r >= 0) ? modeloTabela.getValueAt(r, 0).toString() : "";
        JDialog d = criarDialogo("Devolver", 420, 260);
        JPanel f = criarPainelForm();
        JTextField t = new JTextField(idI, 10); estilizarCampo(t);
        adicionarLinha(f, "ID do Livro:", t);
        JButton btn = criarBotao("Confirmar", COR_BOTAO_DEV, "");
        btn.addActionListener(e -> {
            try {
                int id = Integer.parseInt(t.getText().trim());
                for(Livro l : livros) if(l.getId() == id) {
                    if(!l.getDisponibilidade()) { l.setDisponibilidade(true); atualizarTabela(); d.dispose(); return; }
                    else { JOptionPane.showMessageDialog(d, "Livro já está na biblioteca!"); return; }
                }
                JOptionPane.showMessageDialog(d, "Livro não encontrado!");
            } catch(Exception ex) { JOptionPane.showMessageDialog(d, "ID inválido!"); }
        });
        d.add(f, BorderLayout.CENTER); d.add(criarRodapeDialogo(btn, new JButton("Cancelar")), BorderLayout.SOUTH);
        d.setVisible(true);
    }

    private void abrirDialogoExcluir() {
        int r = tabela.getSelectedRow();
        String idI = (r >= 0) ? modeloTabela.getValueAt(r, 0).toString() : "";
        JDialog d = criarDialogo("Excluir", 420, 260);
        JPanel f = criarPainelForm();
        JTextField t = new JTextField(idI, 10); estilizarCampo(t);
        adicionarLinha(f, "ID do Livro:", t);
        JButton btn = criarBotao("Excluir", COR_BOTAO_EXC, "");
        btn.addActionListener(e -> {
            try {
                int id = Integer.parseInt(t.getText().trim());
                Livro alvo = null;
                for(Livro l : livros) if(l.getId() == id) alvo = l;
                if(alvo != null) { 
                    if(JOptionPane.showConfirmDialog(d, "Excluir \"" + alvo.getTitulo() + "\"?") == 0) {
                        livros.remove(alvo); atualizarTabela(); d.dispose(); 
                    }
                } else JOptionPane.showMessageDialog(d, "Não encontrado!");
            } catch(Exception ex) { JOptionPane.showMessageDialog(d, "ID inválido!"); }
        });
        d.add(f, BorderLayout.CENTER); d.add(criarRodapeDialogo(btn, new JButton("Cancelar")), BorderLayout.SOUTH);
        d.setVisible(true);
    }

    // ── Helpers ────────────────────────────────────────────────────────────────
    private void atualizarTabela() {
        modeloTabela.setRowCount(0);
        for (Livro l : livros) modeloTabela.addRow(new Object[]{l.getId(), l.getTitulo(), l.getAutor(), l.getGenero(), l.getSecao(), l.getDisponibilidade() ? "Disponível" : "Emprestado"});
        lblStatus.setText("Total de livros no acervo: " + livros.size());
    }

    private void filtrarTabela(String f) {
        modeloTabela.setRowCount(0);
        String filter = f.toLowerCase();
        for (Livro l : livros) if (filter.isEmpty() || l.getTitulo().toLowerCase().contains(filter) || l.getAutor().toLowerCase().contains(filter))
            modeloTabela.addRow(new Object[]{l.getId(), l.getTitulo(), l.getAutor(), l.getGenero(), l.getSecao(), l.getDisponibilidade() ? "Disponível" : "Emprestado"});
    }

    private JDialog criarDialogo(String t, int w, int h) {
        JDialog d = new JDialog(this, t, true); d.setSize(w, h); d.setLocationRelativeTo(this); return d;
    }

    private JPanel criarPainelForm() {
        JPanel p = new JPanel(new GridBagLayout()); p.setBackground(COR_FUNDO); p.setBorder(new EmptyBorder(25, 25, 25, 25)); return p;
    }

    private void adicionarLinha(JPanel p, String l, JComponent c) {
        GridBagConstraints g = new GridBagConstraints(); g.insets = new Insets(10, 10, 10, 10); g.anchor = GridBagConstraints.WEST;
        int row = p.getComponentCount() / 2;
        JLabel label = new JLabel(l); label.setFont(new Font("Segoe UI", Font.BOLD, 14));
        g.gridx = 0; g.gridy = row; p.add(label, g);
        g.gridx = 1; g.fill = GridBagConstraints.HORIZONTAL; g.weightx = 1.0; p.add(c, g);
    }

    private JPanel criarRodapeDialogo(JButton bP, JButton bC) {
        JPanel p = new JPanel(new FlowLayout(FlowLayout.RIGHT, 15, 15)); 
        p.setBackground(new Color(240, 240, 240));
        p.setBorder(BorderFactory.createMatteBorder(1, 0, 0, 0, new Color(210, 210, 210)));
        bC.setFont(new Font("Segoe UI", Font.BOLD, 12));
        p.add(bC); p.add(bP);
        bC.addActionListener(e -> ((JDialog)SwingUtilities.getWindowAncestor(bC)).dispose()); return p;
    }

    private void estilizarCampo(JTextField c) {
        c.setFont(new Font("Segoe UI", Font.PLAIN, 15));
        c.setPreferredSize(new Dimension(220, 35));
        c.setBorder(BorderFactory.createCompoundBorder(BorderFactory.createLineBorder(new Color(180, 180, 180)), new EmptyBorder(5, 10, 5, 10)));
    }

    private JButton criarBotao(String t, Color c, String tt) {
        JButton b = new JButton(t); b.setBackground(c); b.setForeground(Color.WHITE);
        b.setFont(new Font("Segoe UI", Font.BOLD, 14)); b.setFocusPainted(false);
        b.setBorderPainted(false); b.setCursor(Cursor.getPredefinedCursor(Cursor.HAND_CURSOR));
        b.setPreferredSize(new Dimension(160, 45)); 
        b.addMouseListener(new MouseAdapter() {
            public void mouseEntered(MouseEvent e) { b.setBackground(c.darker()); }
            public void mouseExited(MouseEvent e) { b.setBackground(c); }
        });
        return b;
    }

