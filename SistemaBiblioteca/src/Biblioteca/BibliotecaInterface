    private void configurarJanela() {
        setTitle("Sistema de Biblioteca");
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setSize(1000, 700);
        setMinimumSize(new Dimension(900, 650));
        setLocationRelativeTo(null);
        try {
            UIManager.setLookAndFeel(UIManager.getSystemLookAndFeelClassName());
        } catch (Exception ignored) {}
    }

    private void encerrarSistema() {
        int confirm = JOptionPane.showConfirmDialog(null, 
            "Deseja realmente encerrar o programa?", "Encerrar", 
            JOptionPane.YES_NO_OPTION, JOptionPane.QUESTION_MESSAGE);
        if (confirm == JOptionPane.YES_OPTION) {
            System.exit(0);
        }
    }

    // ── Tela de Login ──────────────────────────────────────────────────────────
    private void abrirTelaLogin() {
        JDialog loginDlg = new JDialog(this, "Login", true);
        loginDlg.setSize(480, 450);
        loginDlg.setLocationRelativeTo(null);
        loginDlg.setLayout(new BorderLayout());

        JPanel pnl = new JPanel(new GridBagLayout());
        pnl.setBackground(COR_FUNDO);
        pnl.setBorder(new EmptyBorder(30, 40, 30, 40));
        GridBagConstraints gbc = new GridBagConstraints();
        gbc.insets = new Insets(15, 5, 15, 5);
        gbc.fill = GridBagConstraints.HORIZONTAL;

        JLabel lblTitulo = new JLabel("Biblioteca", JLabel.CENTER);
        lblTitulo.setFont(new Font("Segoe UI", Font.BOLD, 32));
        lblTitulo.setForeground(COR_HEADER);
        gbc.gridx = 0; gbc.gridy = 0; gbc.gridwidth = 2;
        pnl.add(lblTitulo, gbc);

        gbc.gridwidth = 1; gbc.gridy = 1;
        JLabel lblEmail = new JLabel("Email:");
        lblEmail.setFont(new Font("Segoe UI", Font.BOLD, 14));
        pnl.add(lblEmail, gbc);
        
        JTextField txtEmail = new JTextField(20);
        estilizarCampo(txtEmail);
        gbc.gridx = 1; pnl.add(txtEmail, gbc);

        gbc.gridx = 0; gbc.gridy = 2;
        JLabel lblSenha = new JLabel("Senha:");
        lblSenha.setFont(new Font("Segoe UI", Font.BOLD, 14));
        pnl.add(lblSenha, gbc);
        
        JPasswordField txtSenha = new JPasswordField(20);
        estilizarCampo(txtSenha);
        gbc.gridx = 1; pnl.add(txtSenha, gbc);

        // Painel de botões
        JPanel pnlAcoes = new JPanel(new GridLayout(1, 2, 15, 0));
        pnlAcoes.setOpaque(false);
        JButton btnEntrar = criarBotao("Entrar", COR_BOTAO_EMP, "");
        JButton btnEncerrar = criarBotao("Encerrar", COR_BOTAO_EXC, "");
        pnlAcoes.add(btnEntrar);
        pnlAcoes.add(btnEncerrar);

        gbc.gridx = 0; gbc.gridy = 3; gbc.gridwidth = 2;
        gbc.insets = new Insets(30, 5, 10, 5);
        pnl.add(pnlAcoes, gbc);

        JButton btnCadastrar = new JButton("Criar nova conta");
        btnCadastrar.setFont(new Font("Segoe UI", Font.BOLD, 14));
        btnCadastrar.setForeground(COR_HEADER);
        btnCadastrar.setBorderPainted(false);
        btnCadastrar.setContentAreaFilled(false);
        btnCadastrar.setCursor(Cursor.getPredefinedCursor(Cursor.HAND_CURSOR));
        gbc.gridy = 4; gbc.insets = new Insets(10, 5, 5, 5);
        pnl.add(btnCadastrar, gbc);

        btnEntrar.addActionListener(e -> {
            String email = txtEmail.getText().trim();
            String senha = new String(txtSenha.getPassword());
            for (Usuario u : usuarios) {
                if (u.getEmail().equals(email) && u.getSenha().equals(senha)) {
                    usuarioLogado = u;
                    loginDlg.dispose();
                    construirInterfacePrincipal();
                    setVisible(true);
                    return;
                }
            }
            JOptionPane.showMessageDialog(loginDlg, "Credenciais inválidas!", "Erro", JOptionPane.ERROR_MESSAGE);
        });

        btnEncerrar.addActionListener(e -> encerrarSistema());
        btnCadastrar.addActionListener(e -> abrirTelaCadastro(loginDlg));

        loginDlg.add(pnl, BorderLayout.CENTER);
        loginDlg.setVisible(true);
    }

    // ── Tela de Cadastro ───────────────────────────────────────────────────────
    private void abrirTelaCadastro(JDialog parent) {
        JDialog cadDlg = new JDialog(parent, "Cadastro", true);
        cadDlg.setSize(520, 550);
        cadDlg.setLocationRelativeTo(parent);
        cadDlg.setLayout(new BorderLayout());

        JPanel pnl = new JPanel(new GridBagLayout());
        pnl.setBackground(COR_FUNDO);
        pnl.setBorder(new EmptyBorder(30, 40, 30, 40));
        GridBagConstraints gbc = new GridBagConstraints();
        gbc.insets = new Insets(12, 5, 12, 5);
        gbc.fill = GridBagConstraints.HORIZONTAL;

        JLabel lblT = new JLabel("Novo Cadastro", JLabel.CENTER);
        lblT.setFont(new Font("Segoe UI", Font.BOLD, 26));
        lblT.setForeground(COR_HEADER);
        gbc.gridx = 0; gbc.gridy = 0; gbc.gridwidth = 2;
        pnl.add(lblT, gbc);

        gbc.gridwidth = 1; 
        gbc.gridy = 1; pnl.add(new JLabel("Nome:"), gbc);
        JTextField tN = new JTextField(20); estilizarCampo(tN); gbc.gridx = 1; pnl.add(tN, gbc);

        gbc.gridx = 0; gbc.gridy = 2; pnl.add(new JLabel("Email:"), gbc);
        JTextField tE = new JTextField(20); estilizarCampo(tE); gbc.gridx = 1; pnl.add(tE, gbc);

        gbc.gridx = 0; gbc.gridy = 3; pnl.add(new JLabel("Senha:"), gbc);
        JPasswordField tS = new JPasswordField(20); estilizarCampo(tS); gbc.gridx = 1; pnl.add(tS, gbc);

        gbc.gridx = 0; gbc.gridy = 4; pnl.add(new JLabel("Cargo:"), gbc);
        JComboBox<String> cbC = new JComboBox<>(new String[]{"Cliente", "Funcionário"});
        cbC.setFont(new Font("Segoe UI", Font.PLAIN, 14));
        gbc.gridx = 1; pnl.add(cbC, gbc);

        JPanel pnlB = new JPanel(new GridLayout(1, 2, 15, 0));
        pnlB.setOpaque(false);
        JButton btnS = criarBotao("Salvar", COR_BOTAO_ADD, "");
        JButton btnC = criarBotao("Voltar", COR_BOTAO_SAIR, "");
        pnlB.add(btnS); pnlB.add(btnC);

        gbc.gridx = 0; gbc.gridy = 5; gbc.gridwidth = 2;
        gbc.insets = new Insets(35, 5, 5, 5);
        pnl.add(pnlB, gbc);

        btnS.addActionListener(e -> {
            if (tN.getText().isEmpty() || tE.getText().isEmpty() || new String(tS.getPassword()).isEmpty()) {
                JOptionPane.showMessageDialog(cadDlg, "Preencha todos os campos!"); return;
            }
            String tipoUsuario = (String)cbC.getSelectedItem();
            if ("Funcionário".equals(tipoUsuario)) {
                usuarios.add(new Funcionario(tN.getText(), tE.getText(), new String(tS.getPassword())));
            } else {
                usuarios.add(new Cliente(tN.getText(), tE.getText(), new String(tS.getPassword())));
            }
            JOptionPane.showMessageDialog(cadDlg, "Cadastro realizado com sucesso!"); cadDlg.dispose();
        });
        btnC.addActionListener(e -> cadDlg.dispose());

        cadDlg.add(pnl, BorderLayout.CENTER);
        cadDlg.setVisible(true);
    }

    // ── Interface Principal ────────────────────────────────────────────────────
    private void construirInterfacePrincipal() {
        JPanel principal = new JPanel(new BorderLayout());
        principal.add(criarHeader(), BorderLayout.NORTH);
        principal.add(criarPainelTabela(), BorderLayout.CENTER);
        principal.add(criarPainelBotoes(), BorderLayout.SOUTH);
        setContentPane(principal);
        
        // Garantir que a tabela seja carregada com os livros existentes ao entrar
        atualizarTabela();
        
        revalidate();
        repaint();
    }

