        h.setBorder(new EmptyBorder(25, 35, 25, 35));

        JLabel t = new JLabel("Sistema de Biblioteca");
        t.setFont(new Font("Segoe UI", Font.BOLD, 28));
        t.setForeground(COR_HEADER_TEXT);

        lblUsuarioLogado = new JLabel("Usuário: " + usuarioLogado.getNome() + " [" + (usuarioLogado instanceof Funcionario ? "Funcionário" : "Cliente") + "]");
        lblUsuarioLogado.setFont(new Font("Segoe UI", Font.ITALIC, 14));
        lblUsuarioLogado.setForeground(new Color(200, 220, 255));

        JPanel txts = new JPanel(new GridLayout(2, 1, 0, 5));
        txts.setOpaque(false);
