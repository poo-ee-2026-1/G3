        configurarJanela();
        // Usuário padrão para testes
        usuarios.add(new Funcionario("Admin", "admin@biblioteca.com", "123"));
        // Acervo inicial de livros
        livros.add(new Livro(proximoId++, "O Morro dos Ventos Uivantes", "Emily Brontë", "Romance", 1));
