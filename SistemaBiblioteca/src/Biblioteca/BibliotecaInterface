package Biblioteca;

import javax.swing.*;
import javax.swing.border.*;
import javax.swing.table.*;
import java.awt.*;
import java.awt.event.*;
import java.util.ArrayList;

public class BibliotecaInterface extends JFrame {

    // ── Dados ──────────────────────────────────────────────────────────────────
    private final ArrayList<Livro> livros = new ArrayList<>();
    private final ArrayList<Usuario> usuarios = new ArrayList<>();
    private Usuario usuarioLogado = null;
    private int proximoId = 1;


    // ── Componentes principais ─────────────────────────────────────────────────
    private JTable tabela;
    private DefaultTableModel modeloTabela;
    private JLabel lblStatus;
    private JPanel painelBotoes;
    private JLabel lblUsuarioLogado;

    // ── Paleta de cores ────────────────────────────────────────────────────────
    private static final Color COR_FUNDO        = new Color(245, 247, 250);
    private static final Color COR_HEADER       = new Color(30, 60, 114);
    private static final Color COR_HEADER_TEXT  = Color.WHITE;
    private static final Color COR_BOTAO_ADD    = new Color(39, 174, 96);
    private static final Color COR_BOTAO_EMP    = new Color(41, 128, 185);
    private static final Color COR_BOTAO_DEV    = new Color(243, 156, 18);
    private static final Color COR_BOTAO_EXC    = new Color(192, 57, 43);
    private static final Color COR_BOTAO_SAIR   = new Color(127, 140, 141);
    private static final Color COR_LINHA_PAR    = new Color(236, 240, 245);
    private static final Color COR_LINHA_IMPAR  = Color.WHITE;
    private static final Color COR_DISPONIVEL   = new Color(39, 174, 96);
    private static final Color COR_EMPRESTADO   = new Color(192, 57, 43);

    // ── Construtor ─────────────────────────────────────────────────────────────
